# Copy this to .env and fill in the keys you actually need:
#   cp .env.example .env
#
# The SDK defaults to Gemini for every role (generator + verifier +
# diversity = gemini-2.5-flash, planner = gemini-2.5-pro), so
# GOOGLE_API_KEY is the only one strictly required. The other two
# only matter if you override `models={...}` with Claude or OpenAI models.

# REQUIRED — get one at https://aistudio.google.com/app/apikey (free tier works)
GOOGLE_API_KEY=your_google_api_key_here

# OPTIONAL — only needed if you pass models={"generator": "claude-..."} etc.
ANTHROPIC_API_KEY=your_anthropic_key_here

# OPTIONAL — only needed if you pass models={"generator": "gpt-..."} etc.
OPENAI_API_KEY=your_openai_key_here

# OPTIONAL — runtime defaults (the SDK reads these if set, otherwise uses code defaults)
MAX_COST_USD=20.0
DEFAULT_BATCH_SIZE=20
QUALITY_THRESHOLD=6.0
DIVERSITY_THRESHOLD=0.85
