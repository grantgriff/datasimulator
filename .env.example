# Copy this to .env and fill in the keys you actually need:
#   cp .env.example .env
#
# The SDK defaults to OpenAI for every role:
#   generator: gpt-5.4-mini
#   verifier:  gpt-4.1-nano
#   diversity: gpt-4.1-nano
#   planner:   gpt-5.4
# So OPENAI_API_KEY is the only one strictly required. The other two
# only matter if you override `models={...}` to mix in Claude or Gemini.

# REQUIRED — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# OPTIONAL — only needed if you pass models={"generator": "claude-..."} etc.
ANTHROPIC_API_KEY=your_anthropic_key_here

# OPTIONAL — only needed if you pass models={"generator": "gemini-..."} etc.
GOOGLE_API_KEY=your_google_api_key_here

# OPTIONAL — runtime defaults (the SDK reads these if set, otherwise uses code defaults)
MAX_COST_USD=20.0
DEFAULT_BATCH_SIZE=20
QUALITY_THRESHOLD=6.0
DIVERSITY_THRESHOLD=0.85
